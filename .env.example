APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bump when deploying public/style.v2.css changes (cache bust for all layouts).
# VIDANEXUS_STYLE_VERSION=31

# --- Docker Compose (optional) ---
# When using docker-compose.yml, point services at the compose network:
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=vidanexus
# DB_USERNAME=vidanexus
# DB_PASSWORD=secret
# REDIS_HOST=redis
# For Horizon profile: QUEUE_CONNECTION=redis, CACHE_STORE=redis (recommended)
# APP_URL=http://localhost:8080
# VITE_PORT=5173

# --- Fawaterak (payments) ---
# Omit FAWATERK_SANDBOX or set auto: sandbox API when APP_ENV is local|development|dev|testing|staging; live when production.
# FAWATERK_SANDBOX=auto
# Force: FAWATERK_SANDBOX=true (staging) or FAWATERK_SANDBOX=false (live) on any APP_ENV.
# FAWATERK_API_KEY=
# Never use example keys from docker-compose or docs — generate Integration → API key in Fawaterak (staging vs live must match FAWATERK_API_BASE_URL / sandbox mode).
# FAWATERK_VENDOR_KEY=
# FAWATERK_WEBHOOK_SECRET=
# Optional: full API base if Fawaterak changes staging URL (must end before /createInvoiceLink), e.g.
# FAWATERK_API_BASE_URL=https://staging.fawaterk.com/api/v2

# --- AI Providers ---
# At least ONE provider must have a valid key for AI tools to work.
# The fallback chain is configured in config/vidanexus.php (default: openai → google → openrouter).
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Override the default provider chain (comma-separated, in priority order):
# AI_DEFAULT_PROVIDER=openai

# --- Social Authentication (Laravel Socialite) ---
# Set SOCIALITE_ENABLED=false to hide all social-login buttons globally.
# SOCIALITE_PROVIDERS lets you disable any one provider without unsetting its credentials.
SOCIALITE_ENABLED=true
SOCIALITE_PROVIDERS=google,github,microsoft

# Google: https://console.cloud.google.com/apis/credentials  → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# GitHub: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Microsoft: https://entra.microsoft.com/  →  App registrations  →  New registration
# Tenant: "common" for any work/personal account; "consumers" for personal MS accounts only;
# or your tenant ID for single-tenant apps.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT=common
